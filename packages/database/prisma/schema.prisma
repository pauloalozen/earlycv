// ---------------------------------------------------------------------------
// Base de Talentos (EarlySignal) — v3.2
//
// Transforma o historico de CVs/analises do EarlyCV numa entidade persistente
// (TalentProfile) reutilizavel para matching com oportunidades. Ver
// AGENTS.md secao "v3.2" para o escopo da sprint.
// ---------------------------------------------------------------------------

enum TalentDataProvenance {
  EXTRACTED_REGEX
  EXTRACTED_IA
  DECLARED_BY_USER
  OBSERVED_INTERACTION
  DERIVED_AGGREGATE
  MANUAL_ADMIN
}

enum TalentIdentityConfidence {
  CONFIRMED_USER
  STRONG_MATCH
  UNVERIFIED
}

enum TalentIdentitySignalType {
  USER_ID
  EMAIL
  PHONE
  LINKEDIN
  NAME_COMPOSITE
}

enum TalentB2bExposureStatus {
  NOT_ELIGIBLE
  OPT_IN_PENDING
  OPT_IN_GRANTED
  OPT_OUT
}

enum TalentContactAuthorization {
  NOT_REQUESTED
  GRANTED
  DECLINED
}

enum TalentCompetencyCategory {
  TECHNICAL_SKILL
  SOFT_SKILL
  TOOL
  METHODOLOGY
  TECHNOLOGY
}

// A pessoa. userId nullable de proposito — guest que vira usuario mantem o
// mesmo TalentProfile, so ganha userId preenchido (nunca cria um profile
// novo). Campos simples (fullName, primaryEmail, currentTitle, seniority,
// primaryAreas...) sao cache de leitura derivado das tabelas normalizadas
// abaixo — nunca escritos diretamente, sempre recalculaveis (ver
// TalentProfileBackfillService / provenance DERIVED_AGGREGATE).
model TalentProfile {
  id                 String                   @id @default(cuid())
  userId             String?                  @unique
  identityConfidence TalentIdentityConfidence @default(UNVERIFIED)

  fullName     String?
  primaryEmail String?
  phone        String?
  linkedinUrl  String?
  city         String?
  state        String?
  country      String?

  currentTitle    String?
  seniority       SeniorityLevel?
  yearsExperience Int?
  primaryAreas    JobArea[]       @default([])

  completenessScore Int @default(0)

  // Matching interno e sempre permitido por padrao (uso interno legitimo
  // sobre dado ja coletado no produto) — exposicao B2B e contato sao gates
  // SEPARADOS, e nunca habilitados pelo backfill (ficam sempre no default
  // "fechado" abaixo).
  internalMatchingEnabled Boolean                    @default(true)
  b2bExposureStatus       TalentB2bExposureStatus    @default(NOT_ELIGIBLE)
  contactAuthorization    TalentContactAuthorization @default(NOT_REQUESTED)

  lastAnalysisAt    DateTime?
  lastInteractionAt DateTime?
  lastEnrichedAt    DateTime?

  // Qual analise "venceu" o enriquecimento por IA atual — "master" (Resume
  // master do usuario) sempre prevalece e nunca e sobrescrito por uma
  // analise avulsa; "avulso" so preenche enquanto nao existir "master".
  // lastEnrichedSourceId e o AnalysisCvSnapshot.id daquela chamada, usado
  // pra nunca reprocessar o mesmo snapshot duas vezes (ex: retry).
  lastEnrichedSourceType String?
  lastEnrichedSourceId   String?

  // Ponteiro direto e permanente pro registro (AnalysisCvSnapshot/Resume)
  // que originou este profile, gravado uma única vez na criação —
  // independente de TalentIdentitySignal. Achado revisando cobertura: um
  // guest cujo CV só rendeu um NAME_COMPOSITE genérico ("Contato", "Resumo
  // Profissional" — cabeçalho de seção, não nome de verdade) podia perder
  // esse sinal pra outro guest com o mesmo texto genérico (só existe UMA
  // linha por valor em TalentIdentitySignal), ficando sem NENHUM vínculo
  // de volta pro próprio CV. Esse campo garante que o vínculo sobrevive
  // mesmo quando o sinal de identidade colide.
  originSourceRecordType String?
  originSourceRecordId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // onDelete: Cascade (corrigido na Fase 2F — era SetNull): a checagem
  // talent_profile_requires_owner (migration 20260904222812) passou a
  // rejeitar qualquer linha sem userId NEM talentSubjectId a partir daquela
  // migration — inclusive a que o SetNull produzia ao apagar um usuário com
  // TalentProfile (achado real rodando a suíte completa nesta fase: exclusão
  // de conta de um usuário com TalentProfile passou a estourar violação de
  // CHECK no banco, quebrando auth.service.ts#deleteCurrentUser e
  // admin-users.service.ts, ambos fluxos reais em produção). Cascade
  // preserva a garantia de dono único e evita o registro órfão — apagar a
  // conta apaga também o TalentProfile e seus dados dependentes (mesmo
  // padrão de privacidade de "excluir minha conta apaga meus dados"),
  // nunca deixa um TalentProfile sem dono para trás.
  user            User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identitySignals TalentIdentitySignal[]
  competencies    TalentCompetency[]
  languages       TalentLanguageSkill[]
  certifications  TalentCertification[]
  experiences     TalentExperience[]
  education       TalentEducation[]
  interactions    TalentInteractionHistory[]
  conflictsAsA    TalentIdentityConflict[]   @relation("ConflictProfileA")
  conflictsAsB    TalentIdentityConflict[]   @relation("ConflictProfileB")

  // Pipeline de perfil canônico de CV (Fase 1, aditivo, sem uso ainda).
  // talentSubjectId é o sujeito anônimo (visitante) dono deste perfil quando
  // userId é null — ver TalentSubject. mergedIntoTalentProfileId é preenchido
  // só quando este perfil foi fundido em outro perfil de usuário via claim
  // (nunca apagado, só marcado).
  talentSubjectId           String?                          @unique
  mergedIntoTalentProfileId String?
  talentSubject             TalentSubject?                   @relation(fields: [talentSubjectId], references: [id], onDelete: SetNull)
  sources                   TalentProfileSource[]
  educationObservations     TalentEducationObservation[]
  competencyObservations    TalentCompetencyObservation[]
  languageObservations      TalentLanguageObservation[]
  certificationObservations TalentCertificationObservation[]

  @@index([identityConfidence])
  @@index([lastInteractionAt])
  @@index([b2bExposureStatus])
  @@index([seniority])
  @@index([city, state])
}

// Evidencia de identidade — chave de lookup do backfill idempotente. Merge
// automatico so acontece quando um sinal STRONG (EMAIL/PHONE/LINKEDIN)
// normalizado bate exatamente com um ja existente; NAME_COMPOSITE nunca
// aciona merge sozinho (ver TalentIdentityConflict).
model TalentIdentitySignal {
  id               String                   @id @default(cuid())
  talentProfileId  String
  signalType       TalentIdentitySignalType
  normalizedValue  String
  confidence       TalentIdentityConfidence
  provenance       TalentDataProvenance
  sourceRecordType String
  sourceRecordId   String
  createdAt        DateTime                 @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([signalType, normalizedValue])
  @@index([talentProfileId])
}

// Par de profiles com sinal STRONG conflitante (ex: mesmo email, telefone
// diferente) — nunca funde automaticamente, so entra na fila de revisao.
model TalentIdentityConflict {
  id                String                   @id @default(cuid())
  profileAId        String
  profileBId        String
  signalType        TalentIdentitySignalType
  profileAValue     String
  profileBValue     String
  detectedAt        DateTime                 @default(now())
  resolvedAt        DateTime?
  resolution        String?
  resolvedByAdminId String?

  profileA TalentProfile @relation("ConflictProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB TalentProfile @relation("ConflictProfileB", fields: [profileBId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

// Skills/tecnologias/ferramentas/metodologias/comportamentais numa unica
// tabela normalizada (category distingue o tipo) — permite indice unico por
// (category, valorNormalizado) pra consultas B2B eficientes ("vaga -> quem
// tem Java+Spring+AWS").
model TalentCompetency {
  id               String                   @id @default(cuid())
  talentProfileId  String
  category         TalentCompetencyCategory
  valueNormalized  String
  valueLabel       String
  proficiencyLevel String?
  provenance       TalentDataProvenance
  sourceRecordType String
  sourceRecordId   String
  confidence       Float                    @default(1.0)
  firstObservedAt  DateTime                 @default(now())
  lastObservedAt   DateTime                 @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, category, valueNormalized])
  @@index([category, valueNormalized])
  @@index([talentProfileId])
}

model TalentLanguageSkill {
  id               String               @id @default(cuid())
  talentProfileId  String
  language         String
  proficiencyLevel String?
  provenance       TalentDataProvenance
  sourceRecordType String
  sourceRecordId   String
  observedAt       DateTime             @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, language])
  @@index([language])
}

model TalentCertification {
  id               String               @id @default(cuid())
  talentProfileId  String
  name             String
  nameNormalized   String
  issuer           String?
  year             Int?
  provenance       TalentDataProvenance
  sourceRecordType String
  sourceRecordId   String
  observedAt       DateTime             @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, nameNormalized])
}

model TalentExperience {
  id                String               @id @default(cuid())
  talentProfileId   String
  company           String
  companyNormalized String
  role              String
  roleNormalized    String
  location          String?
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean              @default(false)
  seniorityAtRole   SeniorityLevel?
  technologiesUsed  String[]
  bulletsJson       Json?
  provenance        TalentDataProvenance
  sourceRecordType  String
  sourceRecordId    String
  observedAt        DateTime             @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, sourceRecordType, sourceRecordId, companyNormalized, roleNormalized])
  @@index([talentProfileId])
  @@index([companyNormalized])
}

model TalentEducation {
  id               String               @id @default(cuid())
  talentProfileId  String
  institution      String
  degree           String?
  fieldOfStudy     String?
  startDate        DateTime?
  endDate          DateTime?
  provenance       TalentDataProvenance
  sourceRecordType String
  sourceRecordId   String
  observedAt       DateTime             @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, sourceRecordType, sourceRecordId])
}

// Fato OBSERVADO de interacao (nunca inferencia) — vaga analisada, empresa,
// cargo, aderencia.
model TalentInteractionHistory {
  id              String          @id @default(cuid())
  talentProfileId String
  sourceType      String
  sourceRecordId  String
  companyName     String?
  jobTitle        String?
  area            JobArea?
  seniority       SeniorityLevel?
  scoreBefore     Int?
  scoreAfter      Int?
  analyzedAt      DateTime

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceRecordId])
  @@index([talentProfileId, analyzedAt])
  @@index([companyName])
}

// =============================================================================
// Pipeline de perfil canônico de CV — Fase 1 (schema aditivo)
// docs/specs/2026-09-04-cv-canonical-profile-pipeline-plan.md (v3, aprovado)
//
// Nada neste bloco é lido/escrito por código de produção ainda. As colunas
// aditivas nos modelos existentes (Resume, AnalysisJob, AnalysisCvSnapshot,
// CvAdaptation, TalentProfile) e as relações abaixo existem só para permitir
// a migration ser aplicada sem quebrar nada — o caminho antigo (Resume 1:1,
// MasterCvCanonicalExtraction, TalentProfile por sessão implícita) continua
// funcionando exatamente como hoje. As CHECK constraints e triggers de
// integridade (seções 7, 9 e 10 do plano) são adicionadas na migration SQL,
// não são expressáveis no Prisma DSL.
// =============================================================================

enum CvSourceOwnerType {
  USER
  GUEST
}

// Conteúdo deduplicado, escopado ao dono (usuário OU sujeito anônimo).
// Nunca guarda metadado de envio (isso é CvSubmission) e nunca muda de dono
// depois de criado — nem em colisão de hash no claim (plano, seção 4.3).
model CvSource {
  id String @id @default(cuid())

  ownerType       CvSourceOwnerType
  userId          String?
  talentSubjectId String?

  textStorageKey String
  textSha256     String

  createdAt DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, não Cascade: um TalentSubject consolidado (merged) nunca deve
  // levar seus CvSource junto por efeito colateral de uma exclusão em outro
  // lugar. Exclusão integral por privacidade é um fluxo próprio, auditado,
  // que lida explicitamente com toda a árvore (CvSource, extrações,
  // observações) — nunca uma cascade incidental.
  talentSubject TalentSubject? @relation(fields: [talentSubjectId], references: [id], onDelete: Restrict)

  submissions              CvSubmission[]
  resumes                  Resume[]
  processingJobs           CvProcessingJob[]
  structuredProfiles       CvStructuredProfile[]
  profileSources           TalentProfileSource[]
  claimGrants              ClaimSourceGrant[]
  equivalencesAsPrimary    CvSourceEquivalence[] @relation("CvSourceEquivalencePrimary")
  equivalencesAsEquivalent CvSourceEquivalence[] @relation("CvSourceEquivalenceEquivalent")

  @@unique([userId, textSha256])
  @@unique([talentSubjectId, textSha256])
  @@index([userId])
  @@index([talentSubjectId])
}

enum CvSubmissionOrigin {
  FILE_UPLOAD
  PASTED_TEXT
  CLAIM
}

// Ocorrência real de ingestão (um envio específico) — preserva metadados de
// arquivo/texto colado sem misturá-los com a identidade de conteúdo do
// CvSource. Um CvSource pode ter N CvSubmission (mesmo conteúdo enviado mais
// de uma vez, por upload ou texto colado).
model CvSubmission {
  id String @id @default(cuid())

  cvSourceId String
  cvSource   CvSource @relation(fields: [cvSourceId], references: [id], onDelete: Cascade)

  origin CvSubmissionOrigin

  fileStorageKey String?
  fileSha256     String?
  fileName       String?
  mimeType       String?
  fileSizeBytes  Int?

  submittedAt DateTime @default(now())

  resume              Resume?
  processingJobs      CvProcessingJob[]
  analysisJobs        AnalysisJob[]
  analysisCvSnapshots AnalysisCvSnapshot[]

  @@index([cvSourceId])
}

enum CvStructuredProfileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Extração canônica versionada de um CvSource. Imutável após READY (trigger
// na migration SQL) — nova versão de extrator/schema gera linha nova, nunca
// sobrescreve.
model CvStructuredProfile {
  id String @id @default(cuid())

  cvSourceId String
  cvSource   CvSource @relation(fields: [cvSourceId], references: [id], onDelete: Cascade)

  extractorVersion String
  schemaVersion    String

  status    CvStructuredProfileStatus @default(PENDING)
  attempts  Int                       @default(0)
  lastError String?

  canonicalJson  Json?
  coverageJson   Json?
  confidenceJson Json?
  evidenceJson   Json?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  analysisCvSnapshots       AnalysisCvSnapshot[]
  analysisJobs              AnalysisJob[]
  cvAdaptations             CvAdaptation[]
  masterDesignations        CvMasterDesignation[]
  educationObservations     TalentEducationObservation[]
  competencyObservations    TalentCompetencyObservation[]
  languageObservations      TalentLanguageObservation[]
  certificationObservations TalentCertificationObservation[]

  @@unique([cvSourceId, extractorVersion, schemaVersion])
  @@index([status])
}

enum CvProcessingJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum CvProcessingMasterIntent {
  NONE
  PROMOTE_IF_FIRST
  PROMOTE_EXPLICIT
}

// Processamento genérico de um CV (extração + Base de Talentos + Master
// opcional) — separado de AnalysisJob (que é só análise CV × vaga e, quando
// existe, depende de um CvProcessingJob). Plano, seção 1.
model CvProcessingJob {
  id String @id @default(cuid())

  cvSourceId     String
  cvSubmissionId String

  masterIntent CvProcessingMasterIntent @default(NONE)

  status    CvProcessingJobStatus @default(PENDING)
  attempts  Int                   @default(0)
  claimedAt DateTime?
  workerId  String?
  lastError String?

  cvStructuredProfileId String?
  masterDesignationId   String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  cvSource     CvSource      @relation(fields: [cvSourceId], references: [id])
  cvSubmission CvSubmission  @relation(fields: [cvSubmissionId], references: [id])
  analysisJobs AnalysisJob[]

  @@index([status])
  @@index([cvSourceId])
}

enum CvMasterPromotionReason {
  FIRST_EVER
  EXPLICIT_FLAG
  CLAIM_PROMOTION
}

// Referência formal de "quem é o Master", inclusive antes de existir conta
// (talentSubjectId). Histórico completo — nunca apaga, só marca
// supersededAt. "Só uma ativa por dono" é garantida por índice único parcial
// na migration SQL (Prisma DSL não expressa índice parcial).
model CvMasterDesignation {
  id String @id @default(cuid())

  ownerType       CvSourceOwnerType
  userId          String?
  talentSubjectId String?

  cvStructuredProfileId String
  cvStructuredProfile   CvStructuredProfile @relation(fields: [cvStructuredProfileId], references: [id])

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  promotedAt     DateTime                @default(now())
  promotedReason CvMasterPromotionReason
  supersededAt   DateTime?

  @@index([userId])
  @@index([talentSubjectId])
}

// Sujeito anônimo formal — a identidade do visitante, nunca a sessão em si.
// guestSessionHash localiza o sujeito via TalentSubjectSessionSignal, mas N
// sessões podem apontar pro mesmo sujeito. Plano, seção 3.
model TalentSubject {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  mergedIntoUserId          String?
  mergedIntoTalentProfileId String?
  mergedAt                  DateTime?

  sessionSignals TalentSubjectSessionSignal[]
  cvSources      CvSource[]
  talentProfile  TalentProfile?

  @@index([mergedIntoUserId])
}

model TalentSubjectSessionSignal {
  id               String   @id @default(cuid())
  talentSubjectId  String
  guestSessionHash String   @unique
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  talentSubject TalentSubject @relation(fields: [talentSubjectId], references: [id], onDelete: Cascade)

  @@index([talentSubjectId])
}

// Relação formal entre um TalentProfile e TODAS as fontes que contribuíram
// pra ele (substitui a leitura implícita via originSourceRecordId, que
// continua existindo só como "qual foi a primeira fonte").
model TalentProfileSource {
  id              String   @id @default(cuid())
  talentProfileId String
  cvSourceId      String
  contributedAt   DateTime @default(now())

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  cvSource      CvSource      @relation(fields: [cvSourceId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, cvSourceId])
}

enum TalentSubjectMergeReason {
  STRONG_SIGNAL_MATCH
  CLAIM_FULL
  CLAIM_PARTIAL_COPY
  MANUAL_ADMIN_REVIEW
  // Correção da migration 20260904222812 (talent-identity-resolver.ts):
  // adoção automática, em tempo real, de um TalentProfile legado sem
  // NENHUM dono (userId/talentSubjectId nulos) quando o resolver o toca de
  // novo. Não é STRONG_SIGNAL_MATCH (não é merge cross-sessão por sinal
  // forte) nem MANUAL_ADMIN_REVIEW (não é revisão humana nem backfill
  // offline, é tráfego real de produção) — ver talent-subject.service.ts
  // #adoptLegacyOwnerlessProfile.
  LEGACY_PROFILE_ADOPTED
}

// Trilha de auditoria de todo merge sujeito↔sujeito ou sujeito↔usuário —
// nunca existe merge silencioso só por sinal inferido (plano, seção 3).
model TalentSubjectMergeEvent {
  id                      String                   @id @default(cuid())
  talentSubjectId         String
  targetUserId            String?
  targetTalentSubjectId   String?
  reason                  TalentSubjectMergeReason
  triggeringAnalysisJobId String?
  createdAt               DateTime                 @default(now())

  @@index([talentSubjectId])
}

// "Este usuário tem acesso comprovado a esta fonte" — independente de quem
// é o dono formal do CvSource. Primitiva única do claim (plano, seção 4):
// resolve o caso de colisão de hash e o caso geral sem transferir CvSource.
model ClaimSourceGrant {
  id                    String   @id @default(cuid())
  cvSourceId            String
  userId                String
  grantedAt             DateTime @default(now())
  provenByAnalysisJobId String

  cvSource CvSource @relation(fields: [cvSourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cvSourceId, userId])
}

// Equivalência leve entre duas fontes com o mesmo hash detectada num claim
// (usuário já possuía CvSource próprio) — só navegação/auditoria, nunca uma
// fusão real (plano, seção 4.3).
model CvSourceEquivalence {
  id                   String   @id @default(cuid())
  primaryCvSourceId    String
  equivalentCvSourceId String
  detectedAt           DateTime @default(now())

  primaryCvSource    CvSource @relation("CvSourceEquivalencePrimary", fields: [primaryCvSourceId], references: [id], onDelete: Cascade)
  equivalentCvSource CvSource @relation("CvSourceEquivalenceEquivalent", fields: [equivalentCvSourceId], references: [id], onDelete: Cascade)

  @@unique([primaryCvSourceId, equivalentCvSourceId])
}

// Observações por documento com identidade por fingerprint determinístico
// (nunca campo nullable cru na chave — Postgres não colide NULL=NULL, o que
// quebraria a idempotência do backfill). Plano, seção 8. Coexistem com as
// tabelas de fato consolidado já existentes (TalentEducation etc.), que
// passam a ser documentadas como "visão recomputável", não fonte primária.
model TalentEducationObservation {
  id                    String   @id @default(cuid())
  talentProfileId       String
  cvStructuredProfileId String
  itemFingerprint       String
  itemIndex             Int
  institutionRaw        String
  degreeRaw             String?
  fieldOfStudyRaw       String?
  periodRaw             String?
  observedAt            DateTime @default(now())

  talentProfile       TalentProfile       @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  cvStructuredProfile CvStructuredProfile @relation(fields: [cvStructuredProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, cvStructuredProfileId, itemFingerprint, itemIndex])
  @@index([talentProfileId])
}

model TalentCompetencyObservation {
  id                    String                   @id @default(cuid())
  talentProfileId       String
  cvStructuredProfileId String
  category              TalentCompetencyCategory
  itemFingerprint       String
  itemIndex             Int
  valueRaw              String
  proficiencyLevelRaw   String?
  observedAt            DateTime                 @default(now())

  talentProfile       TalentProfile       @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  cvStructuredProfile CvStructuredProfile @relation(fields: [cvStructuredProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, cvStructuredProfileId, itemFingerprint, itemIndex])
  @@index([talentProfileId, category])
}

model TalentLanguageObservation {
  id                    String   @id @default(cuid())
  talentProfileId       String
  cvStructuredProfileId String
  itemFingerprint       String
  itemIndex             Int
  languageRaw           String
  proficiencyLevelRaw   String?
  observedAt            DateTime @default(now())

  talentProfile       TalentProfile       @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  cvStructuredProfile CvStructuredProfile @relation(fields: [cvStructuredProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, cvStructuredProfileId, itemFingerprint, itemIndex])
  @@index([talentProfileId])
}

model TalentCertificationObservation {
  id                    String   @id @default(cuid())
  talentProfileId       String
  cvStructuredProfileId String
  itemFingerprint       String
  itemIndex             Int
  nameRaw               String
  issuerRaw             String?
  yearRaw               Int?
  observedAt            DateTime @default(now())

  talentProfile       TalentProfile       @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  cvStructuredProfile CvStructuredProfile @relation(fields: [cvStructuredProfileId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, cvStructuredProfileId, itemFingerprint, itemIndex])
  @@index([talentProfileId])
}

enum MonitorProjectionJobReason {
  MASTER_CREATED
  MASTER_REPLACED
  MASTER_REMOVED
  PREFERENCES_CHANGED
}

enum MonitorProjectionJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Job durável de rematching do Monitor — criado só quando o Master muda de
// fato ou há alteração manual relevante nas preferências monitoradas (plano,
// seção 17). Nunca criado por análise de CV não-Master.
model MonitorProjectionJob {
  id         String                     @id @default(cuid())
  userId     String
  reason     MonitorProjectionJobReason
  status     MonitorProjectionJobStatus @default(PENDING)
  attempts   Int                        @default(0)
  lastError  String?
  createdAt  DateTime                   @default(now())
  finishedAt DateTime?

  @@index([userId])
  @@index([status])
}
