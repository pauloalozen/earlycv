  cvAdaptation CvAdaptation @relation(fields: [cvAdaptationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cvAdaptationId])
  @@index([unlockedAt])
  @@index([source])
  @@index([status])
}

model AnalysisCvSnapshot {
  id                             String               @id @default(cuid())
  userId                         String?
  guestSessionHash               String?
  sourceType                     AnalysisCvSourceType
  textStorageKey                 String
  textSha256                     String
  textSizeBytes                  Int
  originalFileStorageKey         String?
  originalFileSha256             String?
  originalFileName               String?
  originalMimeType               String?
  originalFileSizeBytes          Int?
  professionalProfileFingerprint String
  professionalProfileJson        Json
  capturedAt                     DateTime             @default(now())
  expiresAt                      DateTime?
  claimedAt                      DateTime?
  claimedByUserId                String?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  ownerUser     User?         @relation("AnalysisCvSnapshotOwner", fields: [userId], references: [id], onDelete: SetNull)
  claimedByUser User?         @relation("AnalysisCvSnapshotClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  cvAdaptation  CvAdaptation?
  analysisJob   AnalysisJob?

  // Pipeline de perfil canônico de CV (Fase 1, aditivo, sem uso ainda).
  cvSubmissionId        String?
  cvStructuredProfileId String?
  cvSubmission          CvSubmission?        @relation(fields: [cvSubmissionId], references: [id], onDelete: SetNull)
  cvStructuredProfile   CvStructuredProfile? @relation(fields: [cvStructuredProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guestSessionHash])
  @@index([expiresAt])
  @@index([textSha256])
  @@index([professionalProfileFingerprint])
  @@index([cvSubmissionId])
  @@index([cvStructuredProfileId])
}

// Assíncrono desde a criação (item 3 do plano de LLM síncronas → assíncronas):
// canonicalização da vaga + análise rodam em background, o cliente (guest ou
// autenticado) faz polling nesta linha até status "succeeded"/"failed".
//
// Também é o registro permanente de retenção/analytics decidido em
// 2026-07-18: toda análise feita (guest ou logada) fica guardada aqui pra
// sempre, mesmo que a pessoa nunca converta — hoje esse dado era gerado e
// jogado fora. convertedAt/convertedCvAdaptationId marcam quando (e se) virou
// conta de verdade, sem depender de nenhum token novo: a correlação usa o
// mesmo analysisCvSnapshotId que já flui pela jornada do guest hoje
// (sessionStorage do navegador → saveGuestPreview/claimGuest →
// validateAndClaimSnapshot).
model AnalysisJob {
  id                       String               @id @default(cuid())
  ownerKind                AnalysisJobOwnerKind
  status                   AnalysisJobStatus    @default(pending)
  userId                   String?
  guestSessionHash         String?
  jobDescriptionText       String
  masterCvText             String?
  jobTitle                 String?
  companyName              String?
  adaptedContentJson       Json?
  previewText              String?
  scoreBefore              Int?
  scoreAfter               Int?
  analysisCvSnapshotId     String?              @unique
  lastError                String?
  convertedAt              DateTime?
  convertedCvAdaptationId  String?              @unique
  guestPossessionTokenHash String?              @unique
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  startedAt                DateTime?
  finishedAt               DateTime?

  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  analysisCvSnapshot    AnalysisCvSnapshot? @relation(fields: [analysisCvSnapshotId], references: [id], onDelete: SetNull)
  convertedCvAdaptation CvAdaptation?       @relation(fields: [convertedCvAdaptationId], references: [id], onDelete: SetNull)
  oauthAttempts         OAuthAttempt[]

  // Pipeline de perfil canônico de CV (docs/specs/2026-09-04-cv-canonical-profile-pipeline-plan.md,
  // seção 1.2). Fase 1: só schema aditivo — AnalysisJob passa a poder depender
  // de um CvProcessingJob, mas nada ainda cria/lê essa dependência.
  cvProcessingJobId     String?
  cvSubmissionId        String?
  cvStructuredProfileId String?
  cvProcessingJob       CvProcessingJob?     @relation(fields: [cvProcessingJobId], references: [id], onDelete: SetNull)
  cvSubmission          CvSubmission?        @relation(fields: [cvSubmissionId], references: [id], onDelete: SetNull)
  cvStructuredProfile   CvStructuredProfile? @relation(fields: [cvStructuredProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guestSessionHash])
  @@index([status])
  @@index([createdAt])
  @@index([convertedAt])
  @@index([cvProcessingJobId])
  @@index([cvSubmissionId])
  @@index([cvStructuredProfileId])
}

// Correlação por tentativa de OAuth (Fase 3 do gate de autenticação guest —
// specs/no-guest-analysis-preview-auth-gate-diagnostic-plan-ADENDO-hardening.md
// seção 4.1). `state` é gerado exclusivamente pelo backend (nunca pelo
// navegador) e devolvido pelo Google atrelado à requisição de autorização
// específica que o originou — imune a sobrescrita por outra aba, ao
// contrário de um cookie global. Não é segredo (só chave de correlação
// opaca); quem prova posse da análise é o guestPossessionToken, verificado
// ANTES da criação desta linha (em POST /auth/oauth-attempts), nunca aqui.
model OAuthAttempt {
  id                       String    @id @default(cuid())
  state                    String    @unique
  analysisJobId            String
  conversionContext        String?
  journeySessionInternalId String?
  visitorId                String?
  expiresAt                DateTime
  consumedAt               DateTime?
  createdAt                DateTime  @default(now())

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@index([analysisJobId])
  @@index([expiresAt])
}

model JobSource {
  id                   String                  @id @default(cuid())
  companyId            String
  sourceName           String
  sourceType           JobSourceType
  sourceUrl            String
  parserKey            String
  crawlStrategy        CrawlStrategy
  isActive             Boolean                 @default(true)
  scheduleEnabled      Boolean                 @default(false)
  scheduleCron         String?
  scheduleTimezone     String                  @default("America/Sao_Paulo")
  isFallbackAdapter    Boolean                 @default(false)
  checkIntervalMinutes Int
  lastCheckedAt        DateTime?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  consecutive403Count  Int                     @default(0)
  pausedUntil          DateTime?
  pauseReason          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs                 Job[]
  ingestionRuns        IngestionRun[]
  ingestionBatchItems  IngestionBatchItem[]
  discardedTitles      CrawlerDiscardedTitle[]
  ingestionJobs        IngestionJob[]
  sourceAudits         JobSourceAudit[]

  @@unique([companyId, sourceUrl])
  @@index([companyId])
}

// Fila de revisao do saneamento de Company/JobSource com URL de carreiras
// atribuida errada (ex: empresa brasileira "VERACEL" apontando pro board da
// "Vercel"). Gerada por um heuristico deterministico (sem IA) em
// scripts/audit-company-sources.ts, revisada manualmente (status
// approved/rejected) e depois aplicada por
// scripts/apply-company-source-audit.ts. Ver AGENTS.md/runbook de saneamento
// de fontes para os criterios de tier e de acao por tier.
model JobSourceAudit {
  id                 String    @id @default(cuid())
  companyId          String
  jobSourceId        String?
  // Campo com o dado suspeito: "careersUrl"/"websiteUrl" (em Company) ou
  // "sourceUrl" (em JobSource).
  field              String
  currentUrl         String
  // "confirmed" (bate com outra Company nossa), "high" (dominio claramente
  // nao pertence, sem match no nosso banco) ou "review" (similaridade
  // ambigua / fonte estrangeira fora do escopo do produto).
  tier               String
  confidence         Float
  // Preenchido so no tier "confirmed": a Company que realmente e dona dessa
  // URL. Permite ao apply reatribuir Job/JobSource sem precisar criar
  // empresa nova.
  suspectedOwnerId   String?
  // Nome legivel do dono suspeito quando ele nao existe no nosso banco
  // (tier "high"/"review") — so informativo, nao usado pelo apply.
  suspectedOwnerName String?
  status             String    @default("pending") // pending | approved | rejected | applied
  reviewNote         String?
  detectedAt         DateTime  @default(now())
  reviewedAt         DateTime?
  appliedAt          DateTime?

  company        Company    @relation("JobSourceAuditCompany", fields: [companyId], references: [id], onDelete: Cascade)
  jobSource      JobSource? @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
  suspectedOwner Company?   @relation("JobSourceAuditSuspectedOwner", fields: [suspectedOwnerId], references: [id], onDelete: SetNull)

  @@unique([companyId, field, currentUrl])
  @@index([status])
  @@index([tier])
}

model CrawlerDiscardedTitle {
  id          String    @id @default(cuid())
  jobSourceId String
  jobSource   JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  title           String
  normalizedTitle String
  externalJobId   String?
  canonicalKey    String

  filterReason  String
  filterVersion String

  // Run em que o titulo foi descartado (ou re-descartado, no re-crawl) —
  // canonicalKey e @unique, entao upsert atualiza esse campo a cada
  // ocorrencia, permitindo contar "descartados por essa run" sem depender
  // de janela de tempo.
  ingestionRunId String?
  ingestionRun   IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  discardedAt   DateTime  @default(now())
  whitelistedAt DateTime?

  @@unique([canonicalKey])
  @@index([jobSourceId])
  @@index([filterReason])
  @@index([discardedAt])
  @@index([ingestionRunId])
}

// Candidatos a nova fonte descobertos automaticamente (chute de slug por
// nome ou linha de planilha com URL/adapter já conhecidos), validados
// contra o adapter real antes de virar Company+JobSource de verdade — ver
// DiscoveredCompaniesService. Linhas nunca sao apagadas (so mudam de
// status) pra nunca reprocessar algo ja tentado/descartado.
model DiscoveredCompany {
  id               String                  @id @default(cuid())
  name             String
  normalizedName   String                  @unique
  industry         String?
  websiteUrl       String?
  // Conhecida de inicio (linha completa da planilha) ou preenchida quando
  // a validacao acha um match chutando slug — por isso opcional.
  careersUrl       String?
  adapterType      JobSourceType?
  status           DiscoveredCompanyStatus @default(PENDING)
  jobCount         Int                     @default(0)
  // Vagas no board antes do filtro semantico de tech — so difere de
  // jobCount quando status = NO_TECH_JOBS (board nao vazio, sem match).
  rawJobCount      Int                     @default(0)
  // Como a careersUrl/adapterType foi descoberta: "known" (ja veio na
  // planilha), "web_search" (achou via busca "{nome} vagas") ou
  // "slug_guess" (chute de slug x adapter) — so pra debug/auditoria.
  resolutionMethod String?
  // Ex: lista dos adapters/slugs tentados sem sucesso, ou o motivo do erro
  // estrutural — util pra nao repetir o mesmo chute numa proxima rodada.
  errorMessage     String?
  checkedAt        DateTime?
  linkedCompanyId  String?
  linkedCompany    Company?                @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  // Rótulo livre de origem (ex: nome do arquivo importado), só pra rastreio.
  batchLabel       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  batchItems       IngestionBatchItem[]

  @@index([status])
  @@index([linkedCompanyId])
}

model IngestionSchedulerConfig {
  id            String  @id
  enabled       Boolean @default(false)
  globalCron    String?
  timezone      String  @default("America/Sao_Paulo")
  normalDelayMs Int     @default(22000)
  errorDelayMs  Int     @default(45000)

  // Radar de Oportunidades: config do JobEnrichmentWorker, lida com cache
  // de 60s (EnrichmentConfigService) em vez de env var — ver
  // docs/specs/2026-07-30-radar-oportunidades-sprint1-spec.md.
  enrichmentEnabled        Boolean @default(true)
  enrichmentCronExpression String  @default("*/10 * * * * *")
  enrichmentBatchSize      Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IngestionSchedulerLock {
  id        String   @id
  owner     String
  lockedAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IngestionRun {
  id                     String                  @id @default(cuid())
  jobSourceId            String
  status                 IngestionRunStatus      @default(running)
  startedAt              DateTime                @default(now())
  finishedAt             DateTime?
  newCount               Int                     @default(0)
  updatedCount           Int                     @default(0)
  skippedCount           Int                     @default(0)
  failedCount            Int                     @default(0)
  errorSummary           String?
  previewJson            Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  jobSource              JobSource               @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
  ingestionBatchItems    IngestionBatchItem[]
  crawlerDiscardedTitles CrawlerDiscardedTitle[]

  @@index([jobSourceId, createdAt])
}

model IngestionBatchRun {
  id                String                  @id @default(cuid())
  runKind           IngestionBatchRunKind   @default(CRAWL)
  scopeType         IngestionBatchScopeType
  scopeValue        String
  status            IngestionBatchRunStatus @default(queued)
  requestedByUserId String?
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelRequestedAt DateTime?
  totalSources      Int                     @default(0)
  succeededCount    Int                     @default(0)
  failedCount       Int                     @default(0)
  skippedCount      Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  requestedByUser   User?                   @relation("IngestionBatchRunRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  items             IngestionBatchItem[]
  jobRun            IngestionJobRun?

  @@index([status, createdAt])
  @@index([scopeType, scopeValue, createdAt])
  @@index([requestedByUserId, createdAt])
}

model IngestionBatchItem {
  id                  String                   @id @default(cuid())
  batchRunId          String
  // Nulos pra itens de runKind DISCOVERY_VALIDATE (candidato ainda nao tem
  // JobSource/Company de verdade — so depois de promovido). Pra
  // CRAWL/LOGO_FETCH continuam sempre preenchidos.
  jobSourceId         String?
  companyId           String?
  companyName         String
  sourceName          String?
  sourceType          JobSourceType?
  // So preenchido pra runKind DISCOVERY_VALIDATE — candidato sendo
  // validado (ver DiscoveredCompaniesService.validateOne).
  discoveredCompanyId String?
  status              IngestionBatchItemStatus @default(queued)
  startedAt           DateTime?
  finishedAt          DateTime?
  errorMessage        String?
  ingestionRunId      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  batchRun            IngestionBatchRun        @relation(fields: [batchRunId], references: [id], onDelete: Cascade)
  jobSource           JobSource?               @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
  company             Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discoveredCompany   DiscoveredCompany?       @relation(fields: [discoveredCompanyId], references: [id], onDelete: Cascade)
  ingestionRun        IngestionRun?            @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([batchRunId, jobSourceId])
  @@unique([batchRunId, discoveredCompanyId])
  @@index([batchRunId, status, createdAt])
  @@index([status, updatedAt])
  @@index([jobSourceId])
  @@index([companyId])
  @@index([discoveredCompanyId])
  @@index([ingestionRunId])
}

model IngestionJob {
  id          String  @id @default(cuid())
  name        String
  description String?

  jobType IngestionJobType

  // Escopo (para CRAWL)
  scopeType   IngestionJobScopeType?
  adapterType JobSourceType?
  jobSourceId String?
  jobSource   JobSource?             @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)

  // So usado quando jobType = LOGO_FETCH: true = pula companies que ja tem
  // logoUrl preenchido (delta), false = reprocessa todas as elegiveis pro
  // escopo, mesmo as que ja tem logo.
  onlyMissingLogo Boolean @default(false)

  // So usado quando jobType = DISCOVERY_VALIDATE: quantos candidatos
  // PENDING processar por execucao (null = fila inteira, ate o teto de
  // seguranca — ver QUEUE_HARD_CAP em discovered-companies.service.ts).
  discoveryValidateLimit Int?

  // Agendamento em linguagem humana (sem cron exposto ao usuario)
  scheduleType       IngestionJobScheduleType
  scheduleHour       Int?
  scheduleMinute     Int                      @default(0)
  scheduleInterval   Int?
  scheduleDaysOfWeek Int[]

  // Estado
  isEnabled Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // true para o job MANUAL/SOURCE auto-criado por "Carregar vagas" direto
  // na fonte (ver IngestionJobService.runSourceAdHoc) — existe só pra dar
  // um jobId às execuções ad-hoc aparecerem no histórico, nunca deve
  // aparecer na listagem de jobs (essa só mostra o que foi criado
  // explicitamente pelo popup "Criar job").
  isAdHoc Boolean @default(false)

  runs IngestionJobRun[]

  @@index([jobType, isEnabled])
  @@index([nextRunAt])
}

model IngestionJobRun {
  id    String        @id @default(cuid())
  jobId String?
  job   IngestionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Snapshot do nome/tipo do job no momento da execução — sobrevive à
  // exclusão do job (jobId vira null via onDelete: SetNull) pra o
  // histórico de execuções continuar legível mesmo depois que o job que
  // gerou a execução foi apagado.
  jobName String
  jobType IngestionJobType

  batchRunId String?            @unique
  batchRun   IngestionBatchRun? @relation(fields: [batchRunId], references: [id], onDelete: SetNull)

  status       IngestionJobRunStatus @default(QUEUED)
  triggeredBy  IngestionJobTrigger   @default(SCHEDULE)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime              @default(now())

  @@index([jobId, createdAt])
  @@index([status])
}

// Rastreia execucoes do JobEnrichmentWorker (tick automatico de fundo ou
// "Processar agora" manual) — antes disso, um lote processado nao deixava
// nenhum registro em lugar nenhum, so o status individual de cada
// JobEnrichment mudava. cancelRequestedAt permite parar um lote em
// andamento entre um item e o proximo (mesmo padrao cooperativo do
// IngestionBatchRun).
model EnrichmentBatchRun {
  id                String                @id @default(cuid())
  status            IngestionJobRunStatus @default(QUEUED)
  triggeredBy       IngestionJobTrigger   @default(SCHEDULE)
  batchSize         Int
  processedCount    Int                   @default(0)
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime              @default(now())

  @@index([status, createdAt])
}

enum IngestionJobType {
  CRAWL
  ENRICHMENT
  LOGO_FETCH
  DISCOVERY_VALIDATE
  GOOGLE_INDEXING_BACKFILL
}

enum IngestionJobScopeType {
  ADAPTER
  SOURCE
  ALL
}

enum IngestionJobScheduleType {
  MANUAL
  DAILY
  EVERY_N_HOURS
  WEEKLY
}

enum IngestionJobRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IngestionJobTrigger {
  SCHEDULE
  MANUAL
}

