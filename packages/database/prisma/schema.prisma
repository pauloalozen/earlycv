// Estado de feedback explícito do usuário sobre uma recomendação do Meu
// Monitor — coletado nesta fase apenas para análise futura, não alimenta o
// algoritmo de matching automaticamente (ver Fase 1 do Monitor).
enum RecommendationFeedback {
  POSITIVE
  NEGATIVE
}

// Motivo opcional do feedback negativo — enum fechado desde já (em vez de
// string livre) para permitir agregação/relatório sem depender de
// normalização de texto.
enum RecommendationFeedbackReason {
  TITLE_MISMATCH
  AREA_MISMATCH
  SENIORITY_MISMATCH
  LOCATION_MISMATCH
  COMPANY_MISMATCH
  OTHER
}

// Estado do trabalho de matching em background disparado por
// JobEnrichment.enrichmentStatus -> COMPLETED (ver MonitorMatchingWorker).
// Mesma forma de PENDING/PROCESSING/COMPLETED/FAILED usada por
// JobEnrichment, para reaproveitar o padrão de recuperação de PROCESSING
// travado (recoverStaleProcessing em job-enrichment.worker.ts). Reaproveitado
// também por MonitorProfileMatchJob (mesmo shape de estado, outro sentido de
// fan-out: 1 perfil x N vagas em vez de 1 vaga x N perfis).
enum MonitorMatchJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Estado operacional do Monitor de um usuário — existe só para o frontend
// distinguir "ainda estamos preparando seu Monitor" (INITIALIZING/REFRESHING)
// de "nenhuma vaga encontrada" (ACTIVE + feed vazio). Não é um estado de
// produto novo, é a superfície mínima necessária pra essa distinção.
enum MonitorProfileStatus {
  INITIALIZING
  ACTIVE
  REFRESHING
}

enum SemanticFilterResult {
  PENDING
  ENRICH
  SKIP
}

enum AutoApplyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RATE_LIMITED
}

model User {
  id                           String                        @id @default(cuid())
  email                        String                        @unique
  passwordHash                 String?
  name                         String
  planType                     UserPlanType                  @default(free)
  creditsRemaining             Int                           @default(0)
  analysisCreditsRemaining     Int                           @default(0)
  planActivatedAt              DateTime?
  planExpiresAt                DateTime?
  status                       UserStatus                    @default(pending)
  internalRole                 InternalRole                  @default(none)
  isStaff                      Boolean                       @default(false)
  emailVerifiedAt              DateTime?
  lastLoginAt                  DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  profile                      UserProfile?
  authAccounts                 AuthAccount[]
  refreshTokens                RefreshToken[]
  emailVerificationChallenges  EmailVerificationChallenge[]
  passwordResetTokens          PasswordResetToken[]
  resumes                      Resume[]
  cvAdaptations                CvAdaptation[]
  cvUnlocks                    CvUnlock[]
  planPurchases                PlanPurchase[]
  dailyAnalysisUsages          UserDailyAnalysisUsage[]
  affiliateAttributions        AffiliateAttribution[]
  affiliateCommissionEvents    AffiliateCommissionEvent[]
  analysisSessions             AnalysisSession[]
  analysisRequestFingerprints  AnalysisRequestFingerprint[]
  analysisUsageCounters        AnalysisUsageCounter[]
  analysisProtectionEvents     AnalysisProtectionEvent[]
  businessFunnelEvents         BusinessFunnelEvent[]
  analysisCvSnapshots          AnalysisCvSnapshot[]          @relation("AnalysisCvSnapshotOwner")
  claimedAnalysisCvSnapshots   AnalysisCvSnapshot[]          @relation("AnalysisCvSnapshotClaimedBy")
  requestedIngestionBatchRuns  IngestionBatchRun[]           @relation("IngestionBatchRunRequestedByUser")
  jobApplications              JobApplication[]
  masterCvCanonicalExtractions MasterCvCanonicalExtraction[]
  analysisJobs                 AnalysisJob[]
  radarProfile                 UserRadarProfile?
  savedJobs                    SavedJob[]
  talentProfile                TalentProfile?
  jobRecommendations           UserJobRecommendation[]
  monitorProfileMatchJob       MonitorProfileMatchJob?
  monitorAlertPreference       MonitorAlertPreference?
  monitorDigests               MonitorDigest[]

  // Pipeline de perfil canônico de CV (docs/specs/2026-09-04-cv-canonical-profile-pipeline-plan.md).
  // Fase 1: só schema aditivo, nenhum código lê/escreve nestas relações ainda.
  cvSources         CvSource[]
  claimSourceGrants ClaimSourceGrant[]
}

model UserDailyAnalysisUsage {
  id        String   @id @default(cuid())
  userId    String
  usageDate DateTime
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([usageDate])
}

model PlanPurchase {
  id                     String                   @id @default(cuid())
  userId                 String
  planType               UserPlanType
  amountInCents          Int
  currency               String                   @default("BRL")
  paymentProvider        PaymentProvider
  paymentReference       String                   @unique
  status                 PaymentStatus            @default(none)
  paidAt                 DateTime?
  creditsGranted         Int
  analysisCreditsGranted Int                      @default(0)
  mpPaymentId            String?
  mpMerchantOrderId      String?
  mpPreferenceId         String?
  originAction           PlanPurchaseOriginAction @default(buy_credits)
  originAdaptationId     String?
  autoUnlockProcessedAt  DateTime?
  autoUnlockError        String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([originAdaptationId])
  @@index([paymentReference])
  @@index([mpPaymentId])
}

model PaymentRecoveryEmail {
  id                String                     @id @default(cuid())
  purchaseId        String
  userId            String
  adaptationId      String?
  recoveryGroupKey  String
  step              String                     @default("manual_admin")
  status            PaymentRecoveryEmailStatus
  sentByAdminUserId String
  sentAt            DateTime?
  dryRun            Boolean                    @default(true)
  allowlistMatched  Boolean                    @default(false)
  realEmailSent     Boolean                    @default(false)
  providerMessageId String?
  errorMessage      String?
  subject           String?
  preheader         String?
  templateVariables Json?
  tokenId           String?                    @unique
  clickedAt         DateTime?
  metadataJson      Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  token PaymentRecoveryToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([purchaseId, createdAt])
  @@index([userId, createdAt])
  @@index([adaptationId])
  @@index([recoveryGroupKey, createdAt])
}

model PaymentRecoveryToken {
  id               String    @id @default(cuid())
  purchaseId       String
  userId           String
  adaptationId     String?
  recoveryGroupKey String
  tokenHash        String    @unique
  emailRecordId    String?   @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  emailRecord PaymentRecoveryEmail?

  @@index([purchaseId, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([recoveryGroupKey, createdAt])
}

model PaymentRecoveryIgnore {
  id               String   @id @default(cuid())
  purchaseId       String   @unique
  userId           String
  adaptationId     String?
  reason           String?
  ignoredByAdminId String
  ignoredAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([adaptationId])
  @@index([ignoredAt])
}

model PaymentAuditLog {
  id                   String   @id @default(cuid())
  provider             String
  eventType            String
  actionTaken          String
  mpPaymentId          String?
  mpMerchantOrderId    String?
  mpPreferenceId       String?
  externalReference    String?
  internalCheckoutId   String?
  internalCheckoutType String?
  mpStatus             String?
  errorMessage         String?
  rawPayload           Json?
  createdAt            DateTime @default(now())

  @@index([mpPaymentId])
  @@index([externalReference])
  @@index([internalCheckoutId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, consumedAt, expiresAt])
}

model UserProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  fullName               String?
  contactEmail           String?
  phone                  String?
  linkedinUrl            String?
  professionalSummary    String?
  headline               String?
  currentTitle           String?
  summary                String?
  yearsExperience        Int?
  city                   String?
  state                  String?
  country                String?
  remotePreference       RemotePreference?
  relocationPreference   Boolean?
  targetSalaryMin        Int?
  targetSalaryMax        Int?
  preferredLanguage      String?
  experiencesJson        Json?
  educationJson          Json?
  skillsJson             Json?
  languagesJson          Json?
  certificationsJson     Json?
  profileFieldMetaJson   Json?
  profileSuggestionsJson Json?
  profileReadinessStatus ProfileReadinessStatus @default(empty)
  radarAreas             JobArea[]
  radarSeniority         SeniorityLevel?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRadarProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areas             JobArea[]
  seniority         SeniorityLevel @default(UNKNOWN)
  skills            String[]
  technologies      String[]
  languages         String[]
  certifications    String[]
  careerFingerprint String[]

  preferredWorkModels    String[]
  preferredContractTypes ContractType[]
  openToRelocation       Boolean        @default(false)
  salaryExpectationMin   Int?

  sourceResumeId String?
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Estado do backfill/rematching do Monitor (MonitorProfileMatchingWorker).
  // matchFingerprint é a versão do perfil realmente usada no último matching
  // completo — hash determinístico só dos campos que MatchingEngine.
  // calculateScore consome de fato (areas/skills/technologies/seniority/
  // languages/preferredWorkModels; ver monitor-profile-fingerprint.ts).
  // Deliberadamente NÃO usa careerFingerprint (sem fonte durável fora de uma
  // extração recente, ver refresh() acima) nem updatedAt (bumpa em qualquer
  // escrita, inclusive reconciliações irrelevantes ao matching).
  monitorStatus    MonitorProfileStatus @default(INITIALIZING)
  matchFingerprint String?
  lastMatchedAt    DateTime?

  @@index([userId])
  // Suporta o pré-filtro "vaga -> perfis potencialmente compatíveis" do
  // Meu Monitor (MonitorMatchingWorker): GIN acelera `areas: { hasSome }`,
  // que sem índice faria sequential scan em toda a tabela a cada vaga nova
  // enriquecida. seniority (btree) cobre o segundo filtro barato do
  // pré-filtro (distância de senioridade).
  @@index([areas], type: Gin)
  @@index([seniority])
}

model AuthAccount {
  id                    String       @id @default(cuid())
  userId                String
  provider              AuthProvider
  providerAccountId     String
  providerEmail         String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  sessionId String    @unique
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Resume {
  id                           String                        @id @default(cuid())
  userId                       String
  title                        String
  sourceFileName               String?
  sourceFileUrl                String?
  sourceFileType               String?
  rawText                      String?
  parsedJson                   Json?
  normalizedJson               Json?
  status                       ResumeStatus                  @default(draft)
  kind                         ResumeKind                    @default(master)
  isMaster                     Boolean                       @default(true)
  basedOnResumeId              String?
  templateId                   String?
  targetJobId                  String?
  targetJobTitle               String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  basedOnResume                Resume?                       @relation("ResumeDerivation", fields: [basedOnResumeId], references: [id], onDelete: SetNull)
  derivedResumes               Resume[]                      @relation("ResumeDerivation")
  template                     ResumeTemplate?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  targetJob                    Job?                          @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  cvAdaptationsAsMaster        CvAdaptation[]                @relation("CvAdaptationMaster")
  cvAdaptationAsResult         CvAdaptation?                 @relation("CvAdaptationResult")
  masterCvCanonicalExtractions MasterCvCanonicalExtraction[]
  jobApplicationsAsResumeUsed  JobApplication[]              @relation("JobApplicationResume")

  // Pipeline de perfil canônico de CV (Fase 1, aditivo, sem uso ainda).
  cvSourceId         String?
  cvSubmissionId     String?               @unique
  cvSource           CvSource?             @relation(fields: [cvSourceId], references: [id], onDelete: SetNull)
  cvSubmission       CvSubmission?         @relation(fields: [cvSubmissionId], references: [id], onDelete: SetNull)
  masterDesignations CvMasterDesignation[]

  @@index([userId])
  @@index([basedOnResumeId])
  @@index([templateId])
  @@index([targetJobId])
  @@index([cvSourceId])
}

model CanonicalJob {
  id                            String              @id @default(cuid())
  canonicalJobHash              String              @unique
  requirementSourceHash         String
  canonicalJobJson              Json
  canonicalizationModel         String
  canonicalizationPromptVersion String
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  rawInputs                     JobRawInput[]
  cvAdaptations                 CvAdaptation[]
  jobRequirementSets            JobRequirementSet[]

  @@index([requirementSourceHash])
}

model JobRequirementSet {
  id                    String   @id @default(cuid())
  requirementSourceHash String   @unique
  canonicalJobId        String
  requirementsJson      Json
  analysisModel         String
  analysisPromptVersion String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  canonicalJob  CanonicalJob   @relation(fields: [canonicalJobId], references: [id], onDelete: Cascade)
  cvAdaptations CvAdaptation[]

  @@index([canonicalJobId])
}

model JobRawInput {
  id                String   @id @default(cuid())
  rawJobHash        String   @unique
  rawText           String   @db.Text
  normalizedRawText String   @db.Text
  canonicalJobId    String
  createdAt         DateTime @default(now())

  canonicalJob CanonicalJob @relation(fields: [canonicalJobId], references: [id], onDelete: Cascade)

  @@index([canonicalJobId, createdAt])
}

model MasterCvCanonicalExtraction {
  id             String                            @id @default(cuid())
  userId         String
  resumeId       String
  inputHash      String
  status         MasterCvCanonicalExtractionStatus @default(pending)
  attempts       Int                               @default(0)
  lastError      String?
  canonicalJson  Json?
  coverageJson   Json?
  confidenceJson Json?
  evidenceJson   Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, inputHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
}

model ResumeTemplate {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  targetRole      String?
  fileUrl         String?
  previewImageUrl String?
  structureJson   Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resumes         Resume[]
  cvAdaptations   CvAdaptation[]
}

model Company {
  id                  String               @id @default(cuid())
  name                String
  normalizedName      String               @unique
  websiteUrl          String?
  careersUrl          String?
  linkedinUrl         String?
  industry            String?
  country             String?
  isActive            Boolean              @default(true)
  logoUrl             String?
  logoFetchedAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobSources          JobSource[]
  jobs                Job[]
  ingestionBatchItems IngestionBatchItem[]
  discoveredCompanies DiscoveredCompany[]
  sourceAudits        JobSourceAudit[]     @relation("JobSourceAuditCompany")
  suspectedOwnerOf    JobSourceAudit[]     @relation("JobSourceAuditSuspectedOwner")
}

model CvAdaptation {
  id                          String                @id @default(cuid())
  userId                      String
  masterResumeId              String?
  templateId                  String?
  canonicalJobId              String?
  jobRequirementSetId         String?
  adaptationSource            CvAdaptationSource    @default(uploaded_content)
  inputMode                   CvAdaptationInputMode @default(file_upload)
  jobDescriptionText          String
  jobTitle                    String?
  companyName                 String?
  status                      CvAdaptationStatus    @default(pending)
  adaptedContentJson          Json?
  previewText                 String?
  // Idioma-alvo resolvido pela IA durante adaptCv (fonte única para todo o
  // Kit de Candidatura — carta, prep de entrevista e futuros artefatos leem
  // este valor via JobApplication.language, nunca redetectam).
  language                    String?
  adaptedResumeId             String?               @unique
  aiAuditJson                 Json?
  editedCvJson                Json?
  paymentStatus               PaymentStatus         @default(none)
  paymentProvider             PaymentProvider?
  paymentReference            String?               @unique
  paymentAmountInCents        Int?
  paymentCurrency             String?               @default("BRL")
  paidAt                      DateTime?
  mpPaymentId                 String?
  mpMerchantOrderId           String?
  mpPreferenceId              String?
  failureReason               String?
  isUnlocked                  Boolean               @default(false)
  unlockedAt                  DateTime?
  analysisCvSnapshotId        String?               @unique
  userProfileSnapshotJson     Json?
  uploadedContentSnapshotJson Json?
  analysisInputSnapshotJson   Json?
  generationInputSnapshotJson Json?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  jobApplicationId String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Não usar Cascade: o CV master é editável/substituível a qualquer momento
  // (ver apps/api/src/resumes/resumes.service.ts) e a análise deve
  // sobreviver independente dele — o conteúdo real do CV usado na análise
  // fica em analysisCvSnapshot, não neste ponteiro. masterResumeId é só
  // referência informativa; perdê-la (SetNull) não perde a análise.
  masterResume       Resume?             @relation("CvAdaptationMaster", fields: [masterResumeId], references: [id], onDelete: SetNull)
  template           ResumeTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  canonicalJob       CanonicalJob?       @relation(fields: [canonicalJobId], references: [id], onDelete: SetNull)
  jobRequirementSet  JobRequirementSet?  @relation(fields: [jobRequirementSetId], references: [id], onDelete: SetNull)
  adaptedResume      Resume?             @relation("CvAdaptationResult", fields: [adaptedResumeId], references: [id], onDelete: SetNull)
  analysisCvSnapshot AnalysisCvSnapshot? @relation(fields: [analysisCvSnapshotId], references: [id], onDelete: SetNull)
  cvUnlock           CvUnlock?
  jobApplication     JobApplication?     @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  originAnalysisJob  AnalysisJob?

  // Pipeline de perfil canônico de CV (Fase 1, aditivo, sem uso ainda).
  cvStructuredProfileId String?
  cvStructuredProfile   CvStructuredProfile? @relation(fields: [cvStructuredProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([masterResumeId])
  @@index([paymentReference])
  @@index([mpPaymentId])
  @@index([analysisCvSnapshotId])
  @@index([jobApplicationId])
  @@index([canonicalJobId])
  @@index([cvStructuredProfileId])
}

model CvUnlock {
