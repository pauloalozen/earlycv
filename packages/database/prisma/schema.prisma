model Job {
  id                String                  @id @default(cuid())
  companyId         String
  // Nullable de propósito: excluir uma JobSource não pode arrastar junto
  // firstSeenAt/histórico/URL pública indexada da vaga (ver decisão em
  // JobSourcesService.remove — a vaga é registro de produto, não artefato
  // do pipeline de ingestão). SetNull em vez de Cascade; a UI de exclusão
  // oferece a opção separada de marcar as vagas como "removed".
  jobSourceId       String?
  externalJobId     String?
  sourceJobUrl      String
  canonicalKey      String                  @unique
  slug              String?                 @unique
  title             String
  normalizedTitle   String
  descriptionRaw    String
  descriptionClean  String
  locationText      String
  city              String?
  state             String?
  country           String?
  workModel         String?
  seniorityLevel    String?
  employmentType    String?
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  publishedAtSource DateTime?
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  // Só é atualizado quando title/descriptionClean mudam de verdade entre uma
  // observação de crawler e outra — diferente de lastSeenAt/updatedAt, que
  // são bumped em toda visita do crawler mesmo sem mudança real de
  // conteúdo. Usado como lastModified do sitemap (ver ingestion.service.ts).
  contentUpdatedAt  DateTime?
  status            JobStatus               @default(active)
  metadataJson      Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSource         JobSource?              @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  targetResumes     Resume[]
  enrichment        JobEnrichment?
  applications      JobApplication[]
  savedBy           SavedJob[]
  recommendations   UserJobRecommendation[]
  monitorMatchJob   MonitorMatchJob?

  @@index([companyId])
  @@index([jobSourceId])
  @@index([firstSeenAt])
  @@index([slug])
}

// Auditoria de chamadas à Google Indexing API (GoogleIndexingService) — uma
// linha por notificação enviada (ou tentada), sucesso ou erro. Sem relação
// com Job de propósito: o registro precisa sobreviver mesmo se a vaga for
// deletada depois, e slug já é o identificador estável da URL notificada.
model GoogleIndexingLog {
  id        String   @id @default(cuid())
  slug      String
  type      String
  status    String
  errorMsg  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Vaga salva/favoritada pelo usuário no Radar de Oportunidades — bookmark
// simples, sem relação com o pipeline de candidatura/análise (JobApplication).
// Botão "Salvar vaga" em /vagas e /vagas/[slug]; listagem em /vagas-salvas.
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  // Superfície do produto que originou o save — default RADAR preserva o
  // comportamento de todo caller existente (SaveJobDto.origin é opcional).
  // Só grava a origem do PRIMEIRO save (upsert nunca atualiza este campo);
  // usado por SavedJobsService.save() pra decidir se emite
  // monitor_recommendation_saved, sem criar um sistema de bookmark
  // paralelo — SavedJob continua sendo a única fonte de "vaga salva".
  origin SavedJobOrigin @default(RADAR)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

enum SavedJobOrigin {
  RADAR
  MONITOR
}

// Feed pessoal do Meu Monitor — recomendação persistida de "vaga nova
// realmente aderente" (nível de aderência 3+, ver
// matching.engine.ts::scoreToOpportunityLevel), gerada em background pelo
// MonitorMatchingWorker quando um JobEnrichment transiciona para COMPLETED.
// Deliberadamente separado de SavedJob (bookmark manual do usuário) e de
// JobApplication (candidatura) — ver decisão arquitetural na spec do
// Monitor: nenhuma dessas entidades deve carregar o estado
// recommended/viewed/dismissed/feedback do feed.
model UserJobRecommendation {
  id     String @id @default(cuid())
  userId String
  jobId  String

  score            Int
  opportunityLevel Int

  recommendedAt DateTime  @default(now())
  viewedAt      DateTime?
  dismissedAt   DateTime?
  // Marca "deixou de atender ao Monitor configurado atualmente" —
  // system-driven (MonitorProfileMatchingWorker, na reconciliação após
  // mudança de perfil), distinto de dismissedAt (ação do usuário). Nunca
  // apaga a linha: histórico de score/opportunityLevel/feedback preservado.
  // Uma recomendação supersededAt pode voltar a ficar ativa (supersededAt
  // volta a null) se o perfil mudar de novo e ela voltar a pontuar >=3 — mas
  // só quando dismissedAt for null; dismissed nunca é reativada.
  supersededAt  DateTime?

  feedback       RecommendationFeedback?
  feedbackReason RecommendationFeedbackReason?
  feedbackAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  digestInclusions MonitorDigestRecommendation[]

  @@unique([userId, jobId])
  @@index([userId, recommendedAt])
  @@index([userId, viewedAt])
  @@index([userId, dismissedAt])
  @@index([userId, supersededAt])
  @@index([jobId])
}

// Fila de trabalho do MonitorMatchingWorker — um registro por Job cujo
// enrichment acabou de ficar COMPLETED. Desacopla o gatilho (dentro de
// JobEnrichmentWorker::processItem) do processamento em si (batch/lock/retry
// próprios do worker do Monitor), seguindo o mesmo padrão de estado usado
// por JobEnrichment (PENDING/PROCESSING/COMPLETED/FAILED + attempts) —
// nunca faz "nova vaga × todos os UserRadarProfile" de forma síncrona.
model MonitorMatchJob {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status       MonitorMatchJobStatus @default(PENDING)
  attempts     Int                   @default(0)
  lastError    String?
  matchedCount Int?
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Fila de trabalho do MonitorProfileMatchingWorker — sentido inverso de
// MonitorMatchJob: 1 perfil (usuário) x N vagas recentes/ativas. Um único
// mecanismo cobre os dois gatilhos da Fase 1.5: backfill (primeira vez que o
// usuário entra no Monitor, UserRadarProfile.lastMatchedAt ainda null) e
// rematch (PUT /monitor/profile alterou algo relevante ao matching, ver
// monitor-profile-fingerprint.ts). userId único: múltiplos gatilhos
// enquanto um job ainda está PENDING coalescem numa única execução; o
// worker sempre lê o UserRadarProfile mais recente no momento em que
// processa, nunca um snapshot antigo.
model MonitorProfileMatchJob {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       MonitorMatchJobStatus @default(PENDING)
  attempts     Int                   @default(0)
  lastError    String?
  matchedCount Int?
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum MonitorDigestFrequency {
  DAILY
  WEEKLY
  OFF
}

// Preferência de comunicação do Monitor — deliberadamente separada de
// UserRadarProfile (que é sobre O QUE monitorar, não SOBRE COMO avisar).
// Default DAILY+enabled: alerta é o próprio valor do produto (o usuário já
// configurou o Monitor de propósito), não é e-mail de marketing/aquisição
// — unsubscribe sempre funcional, um clique, sem exigir login (ver
// MonitorDigestUnsubscribeToken em monitor-unsubscribe-token.service.ts).
model MonitorAlertPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled Boolean                @default(true)
  frequency    MonitorDigestFrequency @default(DAILY)

  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MonitorDigestStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

// Quem gerou este MonitorDigest — distingue o disparo do
// MonitorDigestScheduler (rotina normal) de um disparo manual pedido por
// um admin na aba /admin/alerta-vagas (ver admin-monitor.service.ts). Só
// rotula a origem: não muda nenhuma outra regra de conteúdo/envio.
enum MonitorDigestSource {
  SCHEDULER
  ADMIN_MANUAL
}

// Um registro por (usuário, frequência, período) — @@unique é o mecanismo
// de idempotência: o scheduler faz upsert nessa chave antes de montar o
// conteúdo, então um worker reiniciado no meio do processamento nunca
// produz um segundo e-mail pro mesmo período (ver
// monitor-digest.scheduler.ts). scheduledFor é o início do período em UTC
// (meia-noite do dia, pra DAILY; início da semana ISO, pra WEEKLY) — não é
// "quando o cron rodou", é "qual período este digest representa".
model MonitorDigest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  frequency    MonitorDigestFrequency
  status       MonitorDigestStatus    @default(PENDING)
  scheduledFor DateTime

  // Default SCHEDULER preserva o significado dos registros existentes sem
  // backfill — todo MonitorDigest criado antes desta coluna existir veio
  // mesmo da rotina normal. triggeredByAdminId só é preenchido quando
  // source é ADMIN_MANUAL (ver AdminMonitorService.sendDigestNow).
  source             MonitorDigestSource @default(SCHEDULER)
  triggeredByAdminId String?

  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  // Correlaciona com os webhooks do Resend (data.email_id). null até o
  // envio de fato acontecer (ou pra digests SKIPPED, que nunca chegam a
  // enviar).
  providerMessageId String?

  recommendations MonitorDigestRecommendation[]
  events          MonitorDigestEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, frequency, scheduledFor])
  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@index([providerMessageId])
}

// Quais UserJobRecommendation entraram em qual digest — join simples, sem
// duplicar dado (score/opportunityLevel continuam só em
// UserJobRecommendation). Usado pra (a) montar o corpo do e-mail e (b)
// nunca reincluir a mesma recomendação num digest futuro (ver
// monitor-digest-content.service.ts).
model MonitorDigestRecommendation {
  id String @id @default(cuid())

  digestId String
  digest   MonitorDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  recommendationId String
  recommendation   UserJobRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([digestId, recommendationId])
  @@index([recommendationId])
}

enum MonitorDigestEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

// Eventos de webhook do Resend (Svix) — providerEventId é o header
// svix-id, único por tentativa de entrega de webhook; é essa unicidade
// (não algo inventado por nós) que torna o processamento idempotente:
// Resend/Svix reenviam o mesmo svix-id em retry, então um segundo POST do
// mesmo evento vira no-op (ver monitor-digest-webhook.controller.ts).
// digestId fica null só na falha defensiva de não conseguir resolver
// providerMessageId -> MonitorDigest (nunca deveria acontecer em operação
// normal; registrado mesmo assim pra não perder o evento).
model MonitorDigestEvent {
  id String @id @default(cuid())

  digestId String?
  digest   MonitorDigest? @relation(fields: [digestId], references: [id], onDelete: Cascade)

  providerMessageId String
  providerEventId   String                 @unique
  type              MonitorDigestEventType
  metadataJson      Json?
  occurredAt        DateTime

  createdAt DateTime @default(now())

  @@index([digestId])
  @@index([providerMessageId])
}

// Auditoria das ações administrativas do painel de diagnóstico do Meu
// Monitor (requeue de job, força-rematch, reenvio de digest) — não há
// infraestrutura de audit log genérica reutilizável no projeto hoje (o mais
// próximo é PaymentAuditLog, mas é específico de webhook de pagamento).
// entityType/entityId são genéricos de propósito (ex.: "MonitorMatchJob"/
// jobId, "UserRadarProfile"/userId, "MonitorDigest"/digestId) — sem FK, já
// que aponta pra entidades de tipos diferentes.
model MonitorAdminActionLog {
  id      String @id @default(cuid())
  adminId String

  action       String
  entityType   String
  entityId     String
  result       String
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
}

// Singleton (id fixo "default") — horário de geração dos digests
// automáticos, editável via /admin/alerta-vagas. Guardado em hora local
// (não UTC) pra edição no admin ficar legível; MonitorDigestScheduler
// converte pra UTC no momento de decidir se deve disparar (ver
// monitor-digest-schedule.util.ts). Nasce com uma migration que já insere
// a linha default com os valores hoje hardcoded (11:00 America/Sao_Paulo
// diário, segunda-feira pro semanal) — zero mudança de comportamento até
// alguém editar pelo admin.
model MonitorDigestScheduleConfig {
  id String @id @default("default")

  dailyHour       Int    @default(11)
  dailyMinute     Int    @default(0)
  weeklyDayOfWeek Int    @default(1) // 0=domingo..6=sábado (getUTCDay())
  timezone        String @default("America/Sao_Paulo")

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

// Singleton (id fixo "default") — assunto e texto de introdução do
// digest, editáveis via /admin/alerta-vagas (ver
// monitor-digest-email.service.ts). As recomendações continuam montadas
// automaticamente pelo MonitorDigestContentService — só o texto ao redor
// delas é editável. Nasce com uma migration que já insere a linha default
// com os valores hoje hardcoded no service.
model MonitorDigestEmailContent {
  id String @id @default("default")

  subject   String
  introText String

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

model JobEnrichment {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Taxonomia (output do LLM)
  dominantArea         JobArea?
  areas                JobArea[]
  specialties          String[]
  seniority            SeniorityLevel?
  requiredSkills       String[]
  optionalSkills       String[]
  technologies         String[]
  contractType         ContractType?
  languageRequirements String[]
  certifications       String[]
  experienceYearsMin   Int?
  managementRequired   Boolean         @default(false)
  travelRequired       Boolean         @default(false)
  careerFingerprint    String[]

  // Filtro semântico (preenchido antes do LLM)
  semanticFilterResult  SemanticFilterResult @default(PENDING)
  semanticFilterReason  String?
  semanticFilterVersion String?

  // Metadados do enriquecimento
  enrichmentStatus  EnrichmentStatus @default(PENDING)
  enrichmentVersion String?
  enrichmentModel   String?
  enrichmentError   String?
  enrichedAt        DateTime?
  attempts          Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrichmentStatus])
  @@index([semanticFilterResult])
  @@index([dominantArea])
  @@index([seniority])
}

model SemanticFilterConfig {
  id           String   @id @default(cuid())
  version      String   @unique
  isActive     Boolean  @default(false)
  techSignals  String[]
  noiseSignals String[]
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobApplication {
  id                    String               @id @default(cuid())
  userId                String
  jobTitle              String
  companyName           String
  normalizedJobTitle    String
  normalizedCompanyName String
  location              String?
  jobUrl                String?
  jobDescriptionText    String?
  status                JobApplicationStatus @default(ANALYZED)
  origin                JobApplicationOrigin @default(analysis_auto)
  currentCvAdaptationId String?
  scoreBefore           Int?
  scoreAfter            Int?
  notes                 String?
  appliedAt             DateTime?
  nextActionAt          DateTime?
  interviewTitle        String?
  interviewerName       String?
  interviewMeetingUrl   String?
  interviewLocation     String?
  rejectionStrengths    String?
  rejectionImprovements String?
  archivedAt            DateTime?
  deletedAt             DateTime?
  // Cópia de conveniência do language resolvido em CvAdaptation.language
  // (mantida em sync por upsertFromCvAdaptation) — fonte única de idioma
  // para todo o Kit de Candidatura.
  language              String?

  // Radar de Oportunidades: FK opcional quando a candidatura tem origem
  // numa vaga ingerida pelo Radar (não preenchido para candidaturas manuais).
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // v4.1 Auto Apply
  autoApplyEnabled       Boolean          @default(false)
  autoApplyStatus        AutoApplyStatus?
  autoApplyAttemptedAt   DateTime?
  autoApplyCompletedAt   DateTime?
  autoApplyResultJson    Json?
  externalApplicationId  String?
  externalApplicationUrl String?

  // v4.1 Auto Apply: CV master/base usado na candidatura automática.
  // Diferente de currentCvAdaptationId (CV adaptado para a vaga específica).
  resumeUsedId String?
  resumeUsed   Resume? @relation("JobApplicationResume", fields: [resumeUsedId], references: [id], onDelete: SetNull)

  matchScore        Int?
  matchSnapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvAdaptations CvAdaptation[]
  events        JobApplicationEvent[]
  interviewPrep JobApplicationInterviewPrep?
  coverLetter   JobApplicationCoverLetter?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, normalizedCompanyName, normalizedJobTitle])
  @@index([jobId])
  @@index([resumeUsedId])
}

model JobApplicationEvent {
  id               String                  @id @default(cuid())
  jobApplicationId String
  eventType        JobApplicationEventType
  previousStatus   JobApplicationStatus?
  newStatus        JobApplicationStatus?
  metadata         Json?
  createdAt        DateTime                @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId, createdAt])
